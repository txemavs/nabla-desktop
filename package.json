{
  "name": "@nabla/desktop",
  "version": "0.1.0",
  "description": "Reusable 2D window shell for Nabla apps",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "test:package": "node scripts/test-package.mjs",
    "dev:demo": "npm run build && vite --config vite.demo.config.ts --host 127.0.0.1",
    "build:demo": "npm run build && vite build --config vite.demo.config.ts",
    "typecheck:demo": "vue-tsc --noEmit -p tsconfig.demo.json",
    "test:demo": "npm run build:demo && npm run typecheck:demo && node scripts/test-demo.mjs"
  },
  "peerDependencies": {
    "pinia": "^2.1.0 || ^4.0.3",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.4",
    "pinia": "^2.1.7",
    "typescript": "^5.4.3",
    "vite": "^5.2.8",
    "vite-plugin-dts": "^3.8.1",
    "vitest": "^1.4.0",
    "vue": "^3.4.21",
    "vue-tsc": "^2.0.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txemavs/nabla-desktop.git"
  },
  "keywords": [
    "vue",
    "desktop",
    "window-manager",
    "nabla"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/txemavs/nabla-desktop/issues"
  },
  "homepage": "https://github.com/txemavs/nabla-desktop#readme",
  "sideEffects": [
    "**/*.css"
  ]
}
